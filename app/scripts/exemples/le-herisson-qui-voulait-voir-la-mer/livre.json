  "scenes": [
   {
    "id": "f849281f-3662-4200-b50e-ef55bbefda5f",
    "chapitre_id": "c6d92728-ee5f-4f81-a25a-07fb5eeb2be5",
    "projet_id": "9357d0be-d0c8-4cce-a181-8601fbecc9db",
    "reference": 1,
    "titre": "Forêt — sous les feuilles",
    "consigne": "Pépin cherche son déjeuner et trouve une drôle de chose, qui chante quand on l’écoute.",
    "rang": 0,
    "fin": false,
    "hors_livre": false,
    "prise_par_enseignant": true,
    "texte": [
     {
      "id": "c8d1bf00-2f9c-4c6e-af74-ef9272b1e2a2",
      "alt": "Dans la forêt, Pépin le hérisson écoute un coquillage rose et blanc collé contre son oreille ; une chouette dort sur une branche.",
      "type": "image",
      "image": "ab60a285-7106-41bb-9457-18e5046a21f3",
      "largeur": 100,
      "children": [
       {
        "text": ""
       }
      ]
     },
     {
      "id": "7e077424-c11d-446b-90fa-da2c780e5c91",
      "type": "p",
      "children": [
       {
        "text": "Ce matin, Pépin le hérisson fouille les feuilles de la forêt. Il cherche une limace bien dodue pour son petit déjeuner."
       }
      ]
     },
     {
      "id": "c4917603-cf56-479a-b612-3b3ff948abcb",
      "type": "p",
      "children": [
       {
        "text": "Mais ce qu’il trouve n’est pas une limace. C’est une drôle de chose, blanche et rose, enroulée comme un escargot. Pépin la renifle : elle sent le sel. Il la retourne, il la secoue, puis il la colle contre son oreille."
       }
      ]
     },
     {
      "id": "25259f9b-b7b8-4b7d-8814-a37ce36544a2",
      "type": "p",
      "children": [
       {
        "text": "Et là… chhh… chhh… Quelque chose chante, tout au fond."
       }
      ]
     }
    ],
    "version": 1,
    "ecrit_le": "2026-11-25T20:53:55.075Z",
    "rang_livre": null,
    "numero_fixe": null,
    "etat": "prete",
    "tour": 0,
    "etat_le": null,
    "nouvelle_page": false,
    "idee_image": "",
    "description_image": "",
    "verification": [],
    "verification_cochee": []
   },
   {
    "id": "7f63d6c2-4eaf-4b82-be90-1ac910aeff6a",
    "chapitre_id": "c6d92728-ee5f-4f81-a25a-07fb5eeb2be5",
    "projet_id": "9357d0be-d0c8-4cce-a181-8601fbecc9db",
    "reference": 2,
    "titre": "Forêt — la vieille chouette",
    "consigne": "La chouette explique ce qu’est un coquillage, et ce qu’est la mer. Elle dit que c’est trop loin pour Pépin.",
    "rang": 1,
    "fin": false,
    "hors_livre": false,
    "prise_par_enseignant": true,
    "texte": [
     {
      "id": "7981913b-099c-4a87-a627-3eab235b1525",
      "type": "p",
      "children": [
       {
        "text": "Vite, Pépin court réveiller la vieille chouette, qui sait tout."
       }
      ]
     },
     {
      "id": "f286a28c-9a4c-4535-8860-b0630aa9b917",
      "type": "p",
      "children": [
       {
        "text": "— C’est un coquillage, dit-elle en bâillant. Une mouette a dû le laisser tomber. Et ce que tu entends, c’est la mer qui chante."
       }
      ]
     },
     {
      "id": "7ebe7dfd-9416-48ae-90a2-7144e1792be1",
      "type": "p",
      "children": [
       {
        "text": "— La mer ? C’est quoi, la mer ?"
       }
      ]
     },
     {
      "id": "961c62b3-0be3-47a9-b796-7c68d5bcdc50",
      "type": "p",
      "children": [
       {
        "text": "— De l’eau, petit. Tellement d’eau qu’on n’en voit pas le bout."
       }
      ]
     },
     {
      "id": "fbf81ea5-7e87-43f2-9377-e67b9aab8569",
      "type": "p",
      "children": [
       {
        "text": "Pépin ouvre des yeux tout ronds."
       }
      ]
     },
     {
      "id": "c1b0f335-b9e2-4c7a-bd66-df7c1e3f06d4",
      "type": "p",
      "children": [
       {
        "text": "— Je veux la voir !"
       }
      ]
     },
     {
      "id": "d0a2addf-39c2-4787-87b7-75b10abbfedf",
      "type": "p",
      "children": [
       {
        "text": "— Toi ? Mais non ! La mer est bien trop loin pour tes petites pattes."
       }
      ]
     }
    ],
    "version": 1,
    "ecrit_le": "2026-11-25T20:53:55.075Z",
    "rang_livre": null,
    "numero_fixe": null,
    "etat": "prete",
    "tour": 0,
    "etat_le": null,
    "nouvelle_page": false,
    "idee_image": "",
    "description_image": "",
    "verification": [],
    "verification_cochee": []
   },
   {
    "id": "40e2097e-503d-497d-9e42-7765d3f0f8f4",
    "chapitre_id": "c6d92728-ee5f-4f81-a25a-07fb5eeb2be5",
    "projet_id": "9357d0be-d0c8-4cce-a181-8601fbecc9db",
    "reference": 3,
    "titre": "Forêt — le départ",
    "consigne": "Pépin attache le coquillage sur son dos et s’en va, du côté où le soleil se couche.",
    "rang": 2,
    "fin": false,
    "hors_livre": false,
    "prise_par_enseignant": true,
    "texte": [
     {
      "id": "58c0c589-6227-403a-bde0-23d6f3f3e070",
      "type": "p",
      "children": [
       {
        "text": "Trop loin ? Pépin regarde ses pattes. C’est vrai qu’elles sont petites. Puis il écoute encore le coquillage. Chhh… chhh…"
       }
      ]
     },
     {
      "id": "add202bd-3565-48d6-a844-69940202c18e",
      "type": "p",
      "children": [
       {
        "text": "Pépin est petit. Mais Pépin est têtu."
       }
      ]
     },
     {
      "id": "fa7904ba-d18d-497e-bb46-bf5067498288",
      "type": "p",
      "children": [
       {
        "text": "Avec un brin d’herbe, il attache le coquillage sur son dos, bien serré entre ses piquants."
       }
      ]
     },
     {
      "id": "0bd636a8-fa8f-4c8b-8972-a770702ee504",
      "type": "p",
      "children": [
       {
        "text": "— C’est par où ?"
       }
      ]
     },
     {
      "id": "90f4e78e-fef0-4a86-b12d-71ca22506177",
      "type": "p",
      "children": [
       {
        "text": "La chouette soupire et tend une aile."
       }
      ]
     },
     {
      "id": "c42adfb3-5b3e-4245-8e9a-d631c5792542",
      "type": "p",
      "children": [
       {
        "text": "— Par là, du côté où le soleil se couche. Tout droit, toujours tout droit."
       }
      ]
     },
     {
      "id": "9ce09632-39f0-4cd7-8ea6-922bb3acae3e",
      "type": "p",
      "children": [
       {
        "text": "Et le petit hérisson s’en va, le nez en avant."
       }
      ]
     }
    ],
    "version": 1,
